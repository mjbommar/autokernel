# env / secrets
.env
.env~
.env.*
!.env.example

# python / uv
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# autokernel artifacts
.autokernel/
snapshots/
snapshot-*/
*.kfrag.local
# Runtime caches written next to snapshots during interactive use.
# Test fixtures explicitly check in their own caches so tests are
# deterministic across hosts (CI runners lack the relevant /lib/modules).
loadable_modinfo_cache
!tests/fixtures/**/loadable_modinfo_cache

# editors / OS
.vscode/
.idea/
.DS_Store
get-docker.sh

# kernel-patch outbound staging — local-only; .patch files,
# checklists, and send commands for in-flight upstream contributions.
kernel-patches-workspace/

# local provisioning / diagnostic scripts — archived on server0
# (~/laptop-provisioning), never commit (contain internal host/IP details).
# Root-anchored so the project's own install.sh / scripts/*.sh are unaffected.
/setup-nopasswd-sudo.sh
/ec-crash-diag.sh
/install-rc7-candidate.sh
/install-7.3-rc5-candidate.sh
