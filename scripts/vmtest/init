#!/bin/sh
# PID 1 inside the test VM. Prints machine-parseable lines:
#   CHECK <name> <PASS|FAIL> [detail]      BENCH <name> <round> <value>
export PATH=/bin:/usr/bin
mount -t proc proc /proc; mount -t sysfs sys /sys; mount -t devtmpfs dev /dev 2>/dev/null; mount -t tmpfs tmp /tmp
ROUNDS=$(sed -n 's/.*vmt_rounds=\([0-9]*\).*/\1/p' /proc/cmdline); ROUNDS=${ROUNDS:-3}
exec 3>/dev/ttyS1; exec 1>&3
echo "VMTEST kernel=$(cat /proc/sys/kernel/osrelease) cpus=$(grep -c ^processor /proc/cpuinfo)"

# --- correctness ---
if /bin/llrepro >/tmp/ll.out 2>&1 && grep -q 'layer 2 ok' /tmp/ll.out; then echo "CHECK landlock_nested PASS"; else echo "CHECK landlock_nested FAIL $(tr '\n' ' ' </tmp/ll.out)"; fi
if [ "$(echo hello | /usr/bin/xz | /usr/bin/xz -d 2>/dev/null)" = hello ]; then echo "CHECK xz_roundtrip PASS"; else echo "CHECK xz_roundtrip FAIL"; fi
echo "CHECK nmi_watchdog INFO $(cat /proc/sys/kernel/nmi_watchdog 2>/dev/null) hardlockup=$(dmesg | grep -m1 -oE 'NMI watchdog: [^.]*' | tr ' ' _)"
t() { s=$(/usr/bin/date +%s%N); "$@" >/dev/null 2>&1; e=$(/usr/bin/date +%s%N); echo $(( (e-s)/1000 )); }   # usec

for r in $(seq 1 "$ROUNDS"); do
  echo "BENCH sched_pipe $r $(perf bench -f simple sched pipe -l 200000 2>/dev/null | head -1)"
  echo "BENCH sched_messaging $r $(perf bench -f simple sched messaging -g 10 -l 300 2>/dev/null | head -1)"
  echo "BENCH syscall_basic_usec_op $r $(perf bench syscall basic -l 5000000 2>/dev/null | awk '/usecs\/op/{print $1}')"
  echo "BENCH futex_hash_ops $r $(perf bench futex hash -r 3 2>/dev/null | awk '/Averaged/{print $2}')"
  echo "BENCH fork_exec_1000_us $r $(t sh -c 'for i in $(seq 1000); do /usr/bin/true; done')"
  echo "BENCH tmpfs_files_10k_us $r $(t sh -c 'mkdir -p /tmp/f; for i in $(seq 10000); do echo x > /tmp/f/$i; done; rm -rf /tmp/f')"
done

# anything bad in the kernel log during the run?
bad=$(dmesg | grep -cE 'BUG:|Oops|fortify|WARNING:|Call Trace|CFI failure')
if [ "$bad" -eq 0 ]; then echo "CHECK dmesg_clean PASS"; else echo "CHECK dmesg_clean FAIL $bad"; dmesg | grep -E -A3 'BUG:|Oops|fortify|WARNING:|CFI failure' | head -20; fi
echo "CHECK tainted INFO $(cat /proc/sys/kernel/tainted)"
echo "CHECK userns_restrict INFO sysctl=$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null || echo missing) features=$(mount -t securityfs none /sys/kernel/security 2>/dev/null; [ -e /sys/kernel/security/apparmor/features/namespaces/userns_create ] && echo yes || echo no)"
echo "CHECK cfi_mode INFO $(dmesg | grep -m1 -oE 'CFI: Using [A-Za-z -]*' | tr " " _)"
echo VMTEST_DONE
sync; poweroff -f
