# Copy to .env (which is gitignored) and fill in.
# Any one of these providers is sufficient.
export ANTHROPIC_API_KEY=
export OPENAI_API_KEY=
export GOOGLE_API_KEY=
# export GEMINI_API_KEY=

# Optional: override the default pydantic-ai model used by the agent.
# Defaults to anthropic:claude-sonnet-4-6.
# export AUTOKERNEL_MODEL=anthropic:claude-opus-4-7
# export AUTOKERNEL_MODEL=openai:gpt-6-luna

# Optional: OpenAI service tier — auto / default / flex / priority.
# export AUTOKERNEL_SERVICE_TIER=flex

# Optional: OpenAI reasoning effort — minimal / low / medium / high.
# Only applied to openai:* models; ignored for other providers.
# export AUTOKERNEL_REASONING_EFFORT=low

# Optional: how many candidates per LLM batch (default 60).
# export AUTOKERNEL_BATCH_SIZE=60
