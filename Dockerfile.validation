FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/root/.local/bin:$PATH \
    UV_LINK_MODE=copy

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        clang \
        curl \
        git \
        lld \
        qemu-system-x86 \
        shellcheck \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh

WORKDIR /work

COPY .python-version LICENSE README.md pyproject.toml uv.lock ./
COPY .pre-commit-config.yaml ./
COPY install.sh ./install.sh
COPY scripts ./scripts
COPY src ./src
COPY tests ./tests

RUN uv sync --frozen

CMD ["bash", "scripts/validate-docker.sh"]
